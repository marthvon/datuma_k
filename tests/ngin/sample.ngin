                    public @{ => field }@: @{ => field.type }@;
                    public function set@{ => pascal_case(field) }@ (@{ => field }@: @{ => field.type }@) { 
                        this.@{ => field }@ = @{ => field }@; 
                    }
                    public function get@{ => pascal_case(field) }@ () { return this.@{ => field }@; }

