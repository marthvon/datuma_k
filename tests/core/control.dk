flag = true;
out = 0;
if (flag) { out = 1; } else { out = 2; };
tier = 0;
c1 = false;
c2 = true;
if (c1) { tier = 1; } else if (c2) { tier = 2; } else { tier = 3; };
tern = if (flag) { yield 10; } else { yield 20; };
tern2 = if (c1) { yield 10; } else { yield 20; };
total = 0;
for (i = 0; i < 4; ++i) { total += i; }
count = 0;
for (e in [1, 2, 3]) { count += e; }
cond_only = 0;
guard = true;
for (;guard;) { cond_only = 1; guard = false; }
init_only = 0;
for (init_only = 7;;) { break; }
keys = "";
for (k in {a: 1, b: 2}) { keys += k; }
chars = 0;
for (ch in "abc") { chars += 1; }
xs = {items: [1, 2, 3]};
member_sum = 0;
for (e in xs.items) { member_sum += e; }
nested = {inner: {items: [4, 5]}};
chain_sum = 0;
for (e in nested.inner.items) { chain_sum += e; }
