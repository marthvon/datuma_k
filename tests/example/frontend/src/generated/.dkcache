          "line": 64,
          "col": 67,
          "text": "Venue"
        },
        {
          "id": "e1f9e3244b2ca4da",
          "line": 64,
          "col": 72,
          "text": ".create(payload);\n      saved.then(function (row) {\n        navigate(\""
