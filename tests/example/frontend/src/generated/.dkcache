          "line": 66,
          "col": 26,
          "text": "/\" + row.id);\n      }).catch(function (err) {\n        setError(String(err));\n      });\n    }\n  }\n\n  return (\n    <section>\n      <p><Link to=\""
        },
        {
          "id": "b4c035f83aff5568",
          "line": 75,
          "col": 20,
          "text": "/venues"
        },
        {
          "id": "dd0c3e3b94c2417b",
          "line": 75,
          "col": 27,
          "text": "\">Back to list</Link></p>\n      <h1>{editing ? \"Update\" : \"Create\"} "
        },
        {
          "id": "7f23c5e41abb8490",
          "line": 76,
          "col": 43,
          "text": "Venue"
        },
        {
          "id": "8fb9a735aef6c095",
          "line": 76,
          "col": 48,
          "text": "</h1>\n      {error.length > 0 ? <p className=\"error\">{error}</p> : null}\n      <form onSubmit={onSubmit}>\n"
        },
