import { Link } from "react-router-dom";
import { api } from "../api";
import type { @{ => record_ty }@ } from "./types";

export function @{ => list_fn }@() {
  const [rows, setRows] = useState([] as @{ => record_ty }@[]);
  const [error, setError] = useState("");

  useEffect(() => {
    api.@{ => cls }@.list().then(setRows).catch(function (err) {
      setError(String(err));
    });
  }, []);

  if (error.length > 0) {
    return <p className="error">{error}</p>;
  } else {
    return (
      <section>
        <h1>@{ => heading }@</h1>
