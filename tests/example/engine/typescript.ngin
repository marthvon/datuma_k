import { useEffect, useState } from "react";
import { Link, useNavigate, useParams } from "react-router-dom";
import { api } from "../api";
import type { @{ => record_ty }@ } from "./types";

export function @{ => detail_fn }@() {
  const params = useParams();
  const navigate = useNavigate();
  const [row, setRow] = useState(null as @{ => record_ty }@ | null);
  const [error, setError] = useState("");
  const id = Number(params.id);

  useEffect(() => {
    api.@{ => cls }@.get(id).then(setRow).catch(function (err) {
      setError(String(err));
    });
  }, [id]);

  if (error.length > 0) {
    return <p className="error">{error}</p>;
  } else if (row === null) {
    return <p>Loading...</p>;
  } else {
    return (
      <section>
        <p><Link to="@{ => path }@">Back to list</Link></p>
        <h1>@{ => cls }@ {row.id}</h1>
        <dl>
@{
    for (field in model.fields) {
      dt = is_datetime(field.type);
      if (dt) {
        => ```          <dt>@{ => field }@</dt>
          <dd>{row.@{ => field }@.toLocaleString()}</dd>
```
      } else {
        => ```          <dt>@{ => field }@</dt>
          <dd>{row.@{ => field }@}</dd>
```
      }
    }
}@
        </dl>
        <p>
          <Link to={"@{ => path }@/" + row.id + "/edit"}>Edit</Link>
          {" "}
          <button type="button" onClick={function () {
            api.@{ => cls }@.remove(row.id).then(function () {
              navigate("@{ => path }@");
            }).catch(function (err) {
              setError(String(err));
            });
          }}>Delete</button>
        </p>
      </section>
    );
  }
}
```

