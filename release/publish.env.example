# Copy to release/publish.env (gitignored) and fill in values you use.

# GitHub: leave empty if `gh auth login` already works.
# Requires gh on PATH. macOS: brew install gh
# Then gh auth login, or set GH_TOKEN below.
GH_TOKEN=

# Fedora Copr (https://copr.fedorainfracloud.org/api/).
# Requires copr-cli on PATH.
# macOS (Homebrew Python / PEP 668):
#   brew install pipx
#   pipx install copr-cli
#   pipx ensurepath
# Elsewhere: pip install copr-cli, sudo dnf install copr-cli, or python3 -m pip install --user copr-cli
# copr-cli needs both login and token from that page, not the token alone.
# Either save the downloaded file as ~/.config/copr, set COPR_CONFIG to that
# path, or set the three fields below.
COPR_CONFIG=
COPR_LOGIN=
COPR_USERNAME=marthvon
COPR_API_TOKEN=
COPR_URL=https://copr.fedorainfracloud.org

# AUR: path to a private key registered on aur.archlinux.org.
# Leave empty to use ssh-agent / default keys.
AUR_SSH_KEY=

# WinGet fork of microsoft/winget-pkgs. Created on first publish if missing.
# Set WINGET_SKIP=1 to ignore this channel.
WINGET_FORK=marthvon/winget-pkgs
WINGET_SKIP=0

DRY_RUN=0
